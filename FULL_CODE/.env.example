# Copy to .env (never commit .env) and fill in real values.
# Problem pack location (defaults to FULL_CODE/data)
PARDADB_DATASET=./data
# MySQL / PostgreSQL started by the pack's docker-compose.yml
PARDADB_MYSQL_HOST=127.0.0.1
PARDADB_MYSQL_PORT=53306
PARDADB_MYSQL_USER=saffron
PARDADB_MYSQL_PASSWORD=change-me
PARDADB_PG_HOST=127.0.0.1
PARDADB_PG_PORT=55432
PARDADB_PG_USER=saffron
PARDADB_PG_PASSWORD=change-me
# Key for consistent tokens (tok_...). If unset, a random key is created in .state/
PARDADB_HMAC_KEY=
# Optional AI add-on
PARDADB_ML_URL=http://127.0.0.1:8766
PARDADB_ML_THRESHOLD=0.5
