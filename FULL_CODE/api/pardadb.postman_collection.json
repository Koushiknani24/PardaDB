              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"DELETE FROM customers\",\n  \"role\": \"admin\",\n  \"backend\": \"{{backend}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"read-only by design\", () => pm.expect(pm.response.json().blocked).to.be.true);"
                ]
              }
            }
          ]
