    },
    {
      "name": "4. Proof",
      "item": [
        {
          "name": "Tables unchanged (SHA-256 fingerprints)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/integrity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integrity"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"backend\": \"{{backend}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"every table unchanged\", () => { const r = pm.response.json(); const t = r.tables || r; pm.expect(r.all_unchanged).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Audit log (hash chain)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit?limit=20",
